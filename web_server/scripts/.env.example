# Copy to .env and fill in your own values. Never commit .env.
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=replace_with_a_workers_ai_token

# Optional model overrides.
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Facebook Page publishing; only needed for --post-facebook.
FACEBOOK_PAGE_ID=replace_with_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_page_token
# FACEBOOK_GRAPH_API_VERSION=v26.0

# Text sources. Defaults: ../data/epitaka.db and epitaka_<lang>.db beside it.
# EPITAKA_DB_PATH=/srv/epitaka.org/web_server/data/epitaka.db
# EPITAKA_TRANSLATION_DB=/srv/epitaka.org/web_server/data/epitaka_en.db
# EPITAKA_TRANSLATION_LANG=en

# Rendering.
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf
# FONT_PATH_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf

# Reels. CC0 background music; a silent track is used while the folder is empty.
# REEL_MUSIC_DIR=/srv/epitaka/music
# REEL_MUSIC_VOLUME=0.6
