# SEO data-source credentials.
#
# Copy to `.env` in this directory (`.env` is git-ignored, so it stays local):
#     cp .env.example .env
#
# Never commit `.env` itself, and never commit the service-account JSON.

# ---------------------------------------------------------------------------
# Google Search Console  —  FREE, no subscription needed
# ---------------------------------------------------------------------------
# 1. console.cloud.google.com -> create (or pick) a project
# 2. APIs & Services -> Library -> enable "Google Search Console API"
# 3. IAM & Admin -> Service Accounts -> Create service account
# 4. Open it -> Keys -> Add key -> Create new key -> JSON -> download
# 5. Save the file where it is git-ignored (any path named "serviceAccountKey.json")
# 6. In Search Console: Settings -> Users and permissions -> Add user
#    -> paste the service-account email  (...@....iam.gserviceaccount.com)
#    -> Permission: Full (read-only access is enough for reporting)
GSC_CREDENTIALS_PATH=../serviceAccountKey.json

# Property identifier. Use the form that matches your GSC property:
#   Domain property      ->  sc-domain:epitaka.org
#   URL-prefix property  ->  https://epitaka.org/
GSC_PROPERTY=sc-domain:epitaka.org

# ---------------------------------------------------------------------------
# Ahrefs  —  PAID: needs a plan with API access (Lite or above)
# ---------------------------------------------------------------------------
# ahrefs.com -> Account settings -> API token (API v3) -> create token.
# Usage is metered in "integration units" against your plan.
AHREFS_API_TOKEN=

# ---------------------------------------------------------------------------
# Semrush  —  PAID: needs a subscription WITH the "Standard API" package
# ---------------------------------------------------------------------------
# semrush.com -> Subscription info -> API units  (confirms API is included)
# -> get your API key at https://www.semrush.com/api/
SEMRUSH_API_KEY=
